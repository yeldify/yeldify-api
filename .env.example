# PostgreSQL Database Configuration
# Default values for development

# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yeldify

# Alternative (if you want to use a different database)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/budget_db

# For testing
# DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/yeldify_test
